# Required: Discord webhook URL to post notifications to.
DISCORD_WEBHOOK_URL=

# Optional: X (Twitter) API v2 bearer token, used to find trending FC27 posts.
# Leave empty to skip the X source entirely.
X_BEARER_TOKEN=

# Optional: toggle individual sources (true/false). All default to true
# except X, which is skipped automatically when X_BEARER_TOKEN is empty.
ENABLE_FUTBIN=true
ENABLE_FUTGG=true
ENABLE_EA=true
ENABLE_X=true
